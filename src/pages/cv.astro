---

<BaseLayout title="CV" description="Curriculum vitae of Catrina (Nina) Chatman — PharmD Candidate, VCU School of Pharmacy">
  <div class="container">
    <header class="page-header">
      <div class="header-text">
        <h1>Curriculum Vitae</h1>
        <p class="cv-name">Catrina Ashley Chatman</p>
        <p class="cv-contact">
          <a href="tel:+12543839579">254-383-9579</a> · <a href="mailto:Cashley1222@gmail.com">Cashley1222@gmail.com</a> · Disputanta, Virginia 23842
        </p>
      </div>
      <div class="header-actions">
        <a class="btn btn-primary" href={cvPdf} download="Catrina-Chatman-CV.pdf">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          Download PDF
        </a>
        <a class="btn btn-ghost" href={cvPdf} target="_blank" rel="noopener">Open PDF</a>
      </div>
    </header>

    <div class="cv-jump" role="navigation" aria-label="CV sections">
      {sections.map(({ heading }) => (
        <a href={`#${slug(heading)}`}>{heading.replace(/ \(.*\)$/, "")}</a>
      ))}
    </div>

    <article class="cv">
      {sections.map(({ heading, entries }) => (
        <section id={slug(heading)} class="cv-section">
          <h2>{heading}</h2>
          <div class="entries">
            {entries.map(({ date, title, lines }) => (
              <div class="entry">
                <div class="entry-date">{date}</div>
                <div class="entry-body">
                  <h3>{title}</h3>
                  {lines?.map((l) => <p>{l}</p>)}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </article>

    <div class="cv-footer-cta">
      <p>Prefer a printable copy?</p>
      <a class="btn btn-primary" href={cvPdf} download="Catrina-Chatman-CV.pdf">Download CV (PDF)</a>
    </div>
  </div>
</BaseLayout>

<style>
  .container { padding-top: 3rem; padding-bottom: 4rem; }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }
  .page-header h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
  .cv-name { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem; }
  .cv-contact { color: var(--muted); font-size: 0.9rem; }
  .cv-contact a:hover { color: var(--accent); }

  .header-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 10px;
    padding: 0.7rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 700;
    transition: all 0.2s;
  }
  .btn-primary { background: var(--accent); color: #fff; border: 1.5px solid var(--accent); }
  .btn-primary:hover { background: #0f766e; border-color: #0f766e; }
  .btn-ghost { background: var(--surface); color: var(--accent); border: 1.5px solid var(--border); }
  .btn-ghost:hover { border-color: var(--accent); }

  .cv-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .cv-jump a {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 0.3rem 0.8rem;
    transition: all 0.2s;
  }
  .cv-jump a:hover { color: var(--accent); border-color: var(--accent); }

  .cv {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 2rem 2.25rem;
  }

  .cv-section { scroll-margin-top: 5rem; }
  .cv-section + .cv-section { margin-top: 2.25rem; }

  .cv-section h2 {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    border-left: 3px solid var(--accent);
    padding: 0.45rem 0.75rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 1.1rem;
  }

  .entries { display: flex; flex-direction: column; gap: 1.1rem; }

  .entry {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1.25rem;
  }
  .entry-date {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    padding-top: 0.1rem;
  }
  .entry-body h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem; line-height: 1.4; }
  .entry-body p { color: var(--muted); font-size: 0.87rem; line-height: 1.6; }

  .cv-footer-cta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cv { padding: 1.25rem; }
    .entry { grid-template-columns: 1fr; gap: 0.2rem; }
    .entry-date { font-size: 0.78rem; }
    .cv-jump { flex-wrap: nowrap; overflow-x: auto; margin-left: -2rem; margin-right: -2rem; padding: 0 2rem 0.25rem; scrollbar-width: none; }
    .cv-jump a { white-space: nowrap; }
  }
</style>
